{
  "entities": {
    "House": {
      "title": "House",
      "description": "A boutique shared house accommodation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "pricePerNight": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "beds": { "type": "string" },
        "guests": { "type": "number" },
        "tag": { "type": "string" },
        "tagClass": { "type": "string" },
        "images": { "type": "array" },
        "features": { "type": "array" }
      },
      "required": ["id", "name", "location", "description", "pricePerNight", "beds", "guests"]
    },
    "Room": {
      "title": "Room",
      "description": "An individual room inside a shared house.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "available": { "type": "boolean" },
        "images": { "type": "array" },
        "beds": { "type": "string" },
        "view": { "type": "string" }
      },
      "required": ["id", "name", "description", "price", "available", "beds", "view"]
    },
    "BlogPost": {
      "title": "BlogPost",
      "description": "A travel story or local guide article written by the host.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "author": { "type": "string" },
        "readTime": { "type": "string" },
        "publishedDate": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["id", "category", "title", "excerpt", "content", "author", "image"]
    },
    "HostProfile": {
      "title": "HostProfile",
      "description": "Profile information for Host Mila.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["name", "title", "bio", "email"]
    },
    "AppData": {
      "title": "AppData",
      "description": "Persistent document storing houses, rooms, stories, and host profile.",
      "type": "object",
      "properties": {
        "houses": { "type": "array" },
        "roomsByHouse": { "type": "object" },
        "blogPosts": { "type": "array" },
        "hostProfile": { "type": "object" }
      },
      "required": ["houses", "roomsByHouse", "blogPosts", "hostProfile"]
    },
    "Review": {
      "title": "Review",
      "description": "A review for a house.",
      "type": "object",
      "properties": {
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "date": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" }
      },
      "required": ["authorName", "date", "rating", "comment"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "A message from a guest to the host.",
      "type": "object",
      "properties": {
        "guestName": { "type": "string" },
        "guestEmail": { "type": "string" },
        "houseName": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string" },
        "read": { "type": "boolean" },
        "replied": { "type": "boolean" }
      },
      "required": ["guestName", "guestEmail", "houseName", "subject", "message", "date", "read"]
    },
    "PastBooking": {
      "title": "Past Booking",
      "description": "Records that a guest has stayed at a house, allowing them to review.",
      "type": "object",
      "properties": {
        "guestEmail": { "type": "string" },
        "houseId": { "type": "string" }
      },
      "required": ["guestEmail", "houseId"]
    }
  },
  "firestore": {
    "/appData/{docId}": {
      "schema": { "$ref": "#/entities/AppData" },
      "description": "Master storage for houses, rooms, stories, and profile."
    },
    "/houses/{houseId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews for a specific house."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Message inquiries sent by guests."
    },
    "/pastBookings/{bookingId}": {
      "schema": { "$ref": "#/entities/PastBooking" },
      "description": "Past bookings to verify review eligibility."
    }
  }
}

